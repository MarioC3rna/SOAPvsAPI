<?xml version="1.0" encoding="UTF-8"?>

<definitions name="SumaServiceImplService"
             targetNamespace="http://soap.tarea.com/"
             xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:tns="http://soap.tarea.com/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">

    
    <types>
        <xsd:schema targetNamespace="http://soap.tarea.com/">
            <xsd:element name="sumar" type="tns:sumar"/>
            <xsd:complexType name="sumar">
                <xsd:sequence>
                    <xsd:element name="a" type="xsd:int"/>
                    <xsd:element name="b" type="xsd:int"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:element name="sumarResponse" type="tns:sumarResponse"/>
            <xsd:complexType name="sumarResponse">
                <xsd:sequence>
                    <xsd:element name="return" type="xsd:int"/>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:schema>
    </types>

   
    <message name="sumar">
        <part name="parameters" element="tns:sumar"/>
    </message>
    <message name="sumarResponse">
        <part name="parameters" element="tns:sumarResponse"/>
    </message>

   
    <portType name="SumaService">
        <operation name="sumar">
            <input message="tns:sumar"/>
            <output message="tns:sumarResponse"/>
        </operation>
    </portType>


    <binding name="SumaServiceImplPortBinding" type="tns:SumaService">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
        <operation name="sumar">
            <soap:operation soapAction=""/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
        </operation>
    </binding>


    <service name="SumaServiceImplService">
        <port name="SumaServiceImplPort" binding="tns:SumaServiceImplPortBinding">
            <soap:address location="http://localhost:8080/ws/suma"/>
        </port>
    </service>
</definitions>
